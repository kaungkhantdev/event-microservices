# Root .gitignore for Microservices System

# Environment variables
.env
.env.local
.env.*.local
.env.production
.env.development

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Build outputs
dist/
build/
out/
*.tsbuildinfo

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Testing
coverage/
*.lcov
.nyc_output/
.grunt/
.lock-wscript

# IDEs and editors
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
.project
.classpath
.settings/
*.sublime-workspace
*.sublime-project

# OS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Docker
.dockerignore
docker-compose.override.yml

# Database
*.sqlite
*.sqlite3
*.db

# Docker volumes data (persisted data)
postgres_data/
redis_data/
elasticsearch_data/

# Load testing results
load-tests/results/*.json
load-tests/results/*.html
load-tests/results/*.xml
load-tests/results/*.txt

# Temporary files
tmp/
temp/
*.tmp
*.bak
*.swp
*~.nib

# Package manager lock files (uncomment if you want to ignore them)
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# TypeScript
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional stylelint cache
.stylelintcache

# Microbundle cache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# parcel-bundler cache (https://parceljs.org/)
.cache
.parcel-cache

# Next.js build output
.next
out

# Nuxt.js build / generate output
.nuxt
dist

# Gatsby files
.cache/
# Comment in the public line in if your project uses Gatsby and not Next.js
# public

# vuepress build output
.vuepress/dist

# vuepress v2.x temp and cache directory
.temp
.cache

# Docusaurus cache and generated files
.docusaurus

# Serverless directories
.serverless/

# FuseBox cache
.fusebox/

# DynamoDB Local files
.dynamodb/

# TernJS port file
.tern-port

# Stores VSCode versions used for testing VSCode extensions
.vscode-test

# yarn v2
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

# PM2
.pm2

# Sentry
.sentryclirc

# K6 cloud output
k6-cloud-*.json

# Artillery output
artillery-report-*.json
artillery-report-*.html

# JMeter
*.jtl
*.jmx~

# Locust
locust-*.csv

# Monitoring and APM
newrelic_agent.log
datadog-trace.log

# Secrets and credentials (NEVER commit these!)
*.key
*.pem
*.crt
*.p12
*.pfx
credentials.json
service-account.json
gcp-credentials.json
aws-credentials.json

# Backup files
*.backup
*.old

# Archive files
*.zip
*.tar
*.tar.gz
*.rar
*.7z

# Editor directories and files
.cache/
.temp/
.tmp/
