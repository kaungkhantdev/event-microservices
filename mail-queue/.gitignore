# Mail Queue Service .gitignore

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment variables
.env
.env.local
.env.*.local

# Email test files (generated during testing)
test-emails/
email-output/

# Logs
logs/
*.log

# Build output
dist/
build/

# Testing
coverage/
.nyc_output/

# Cache
.cache/
.eslintcache

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store

# Temporary files
tmp/
temp/
*.tmp

# SMTP credentials (NEVER commit)
smtp-config.json
email-credentials.json
