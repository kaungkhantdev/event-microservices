# Payment Service .gitignore

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment variables
.env
.env.local
.env.*.local

# Payment provider credentials (NEVER commit these!)
stripe-config.json
paypal-config.json
payment-credentials.json
*.key
*.pem

# Transaction logs (may contain sensitive data)
transactions/
payment-logs/

# Logs
logs/
*.log

# Build output
dist/
build/

# Testing
coverage/
.nyc_output/

# Cache
.cache/
.eslintcache

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store

# Temporary files
tmp/
temp/
*.tmp

# PCI compliance - never commit card data
card-data/
pci-logs/
